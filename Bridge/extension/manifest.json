{
  "manifest_version": 3,
  "name": "Galmuri Chrome Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "134",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "bookmarks"
  ],
  "action": {
    "default_popup": "launcher.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
