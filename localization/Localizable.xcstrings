            "value": "Check the folder’s read permissions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダの読み取り権限を確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더의 읽기 권한을 확인해 주세요"
