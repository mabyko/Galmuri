    "settings.encryptedBookmarksDetail": {
      "comment": "Disabled Labs placeholder only; no activation, persisted preference or Keychain access. Translations need in-context review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support for Chrome’s encrypted bookmark storage is planned. This feature is unavailable in this version. Galmuri does not request Keychain access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromeの暗号化されたブックマーク保存形式への対応を検討しています。現在のバージョンでは利用できず、Galmuriはキーチェーンへのアクセスを要求しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome의 암호화된 북마크 저장소 지원을 검토하고 있습니다. 현재 버전에서는 사용할 수 없으며, Galmuri는 키체인 접근을 요청하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "计划支持 Chrome 的加密书签存储。当前版本暂不可用，Galmuri 不会请求访问钥匙串。"
          }
        }
      }
    },
