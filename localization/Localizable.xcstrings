    "profile.accessDetail": {
      "comment": "Browser connection UI; preserve browser/folder names. Non-English text needs in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not allow this read. Choose Allow Access, then select the “%@” folder in the next dialog. Your browser originals stay unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOSでフォルダを読み取れませんでした。「アクセスを許可」を押し、次のダイアログで「%@」フォルダを選択してください。ブラウザの原本は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS에서 폴더를 읽을 수 없었습니다. 접근 허용을 누른 뒤 다음 창에서 “%@” 폴더를 선택해 주세요. 브라우저 원본은 변경하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 未允许读取此文件夹。请点击“允许访问”，然后在下一对话框中选择“%@”文件夹。浏览器原始数据不会更改。"
          }
        }
      }
    },
