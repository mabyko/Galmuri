    "review.pendingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the saved source snapshot with your working copy. These edits have not been applied to Chrome."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져온 원본 사본과 현재 작업본의 차이입니다. 아직 Chrome에 반영하지 않은 편집 내용입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存済みの元データと作業コピーを比較します。これらの編集はまだChromeに反映していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处比较已保存的源快照和工作副本。这些编辑尚未应用到 Chrome。"
          }
        }
      }
    },
    "review.pendingApplyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview does not change your work or browser. Experimental browser apply is available separately in Settings → Labs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 창에서는 작업본이나 브라우저를 변경하지 않습니다. 브라우저 반영 실험은 설정 → 실험실에서 별도로 진행합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この確認画面では作業コピーやブラウザを変更しません。ブラウザへの反映は設定 → 実験室から別途行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此预览不会更改工作副本或浏览器。实验性浏览器写入请在设置 → 实验室中另行操作。"
          }
        }
      }
    },
    "refresh.noWorkingChanges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing adds no further changes to your working copy. Your existing edits are retained."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새로고침으로 작업본에 추가할 변경은 없습니다. 기존 편집 내용은 그대로 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再読込で作業コピーに追加する変更はありません。既存の編集内容は保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刷新不会为工作副本带来其他更改。现有编辑将被保留。"
          }
        }
      }
    },
