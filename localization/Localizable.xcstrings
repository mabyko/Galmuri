    "permission.noChromeSwitch": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Google Chrome entry, or still unable to connect? You can also choose the browser folder in the standard macOS dialog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Chromeの項目がない場合や接続できない場合は、macOS標準のダイアログでブラウザフォルダを選択する方法もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google Chrome 항목이 없거나 계속 연결되지 않으면, macOS 표준 창에서 브라우저 폴더를 선택할 수도 있습니다."
          }
