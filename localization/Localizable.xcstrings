    "permission.checkStepDetail": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the folder can be read, the profile chooser opens automatically. Canceling keeps your existing work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダを読み取れるようになると、プロファイル選択画面が自動的に開きます。キャンセルしても既存の作業は保持されます。"
          }
        },
        "ko": {
