    "api.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental: reads the paired Chrome model. Browser writes are enabled only in marked dedicated test profiles. Deletion moves items to a visible Chrome recovery folder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실험 기능입니다. 승인한 Chrome 프로필을 읽습니다. 반영은 전용 테스트 프로필에서만 가능하며, 삭제한 항목은 Chrome의 복구 폴더로 이동합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実験機能です。承認した Chrome プロフィールを読み取ります。反映は専用テストプロフィールのみで、削除した項目は Chrome の復元フォルダに移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "实验功能：读取已批准的 Chrome 个人资料。仅能向专用测试个人资料应用更改；删除会将项目移至 Chrome 中可见的恢复文件夹。"
          }
        }
      }
    },
