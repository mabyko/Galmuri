            "value": "仅保存合并的工作副本"
          }
        }
      }
    },
    "api.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to paired Chrome"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결한 Chrome에 반영"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続中の Chrome に反映"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "应用到已连接的 Chrome"
          }
        }
      }
    },
    "api.applyHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome stays open. Review the complete diff and every conflict. Each API call is recorded; failures can leave partial changes. Removed items move to a visible recovery folder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome을 켠 상태로 반영합니다. 전체 변경 내역과 충돌을 검토하세요. 호출마다 기록하며, 실패하면 일부만 반영될 수 있습니다. 삭제할 항목은 복구 폴더로 옮깁니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome を開いたまま反映します。差分とすべての競合を確認してください。API 呼び出しごとに記録しますが、失敗時は一部だけ反映される場合があります。削除対象は復元フォルダに移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome 将保持运行。请检查全部差异和冲突。每次 API 调用都会记录，但失败可能留下部分更改。删除的项目将移至可见的恢复文件夹。"
          }
        }
      }
    },
    "api.ack": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I reviewed these changes and the recovery limits"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "변경 내역과 복구 제한을 확인했어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更内容と復元の制限を確認しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我已检查这些更改和恢复限制"
          }
        }
      }
    },
    "api.deleteTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from this working copy?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업본에서 삭제할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この作業コピーから削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从此工作副本中移除？"
          }
        }
      }
    },
    "api.deleteHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder contents are included. Chrome is unchanged until apply; applying moves originals to a recovery folder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더 안의 항목도 포함합니다. 반영 전에는 Chrome이 바뀌지 않으며, 반영할 때 원본을 복구 폴더로 옮깁니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダの内容も含みます。反映するまで Chrome は変更されず、反映時に元の項目を復元フォルダへ移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "包括文件夹中的项目。应用前 Chrome 不会改变；应用时会将原始项目移至恢复文件夹。"
          }
        }
      }
    },
    "api.adoptTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Chrome state after interruption"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "중단 후 Chrome 상태 검토"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "中断後の Chrome の状態を確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检查中断后的 Chrome 状态"
          }
        }
      }
    },
    "api.adoptHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous apply may have partly completed. This archives the current working copy, then adopts the reviewed Chrome state locally and clears the retry block. It does not undo browser changes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이전 반영이 일부 완료되었을 수 있습니다. 작업본을 먼저 보관한 뒤 검토한 Chrome 상태를 새 기준으로 삼고 재시도 차단을 해제합니다. 브라우저 변경을 되돌리지는 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "前回の反映が一部完了している可能性があります。作業コピーを保存してから、確認した Chrome の状態を新しい基準にし、再試行の制限を解除します。ブラウザの変更は取り消しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上一次操作可能已部分完成。此操作会先归档当前工作副本，再采用已检查的 Chrome 状态并解除重试限制。不会撤销浏览器中的更改。"
          }
        }
      }
    },
    "api.adopt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive work and adopt Chrome state"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 보관 후 Chrome 상태 사용"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "作業を保存して Chrome の状態を採用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "归档工作并采用 Chrome 状态"
          }
        }
      }
    },
    "api.applied": {
      "localizations": {
