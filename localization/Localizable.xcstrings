{
  "sourceLanguage": "en",
  "strings": {
    "Account or encrypted bookmark storage detected; plaintext may not be authoritative.": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account or encrypted bookmark storage detected; plaintext may not be authoritative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウント用または暗号化されたブックマーク保存領域を検出しました。平文ファイルが正しい原本とは限りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정 또는 암호화된 북마크 저장소가 발견되었습니다. 일반 텍스트 파일이 실제 원본이 아닐 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检测到账户或加密书签存储；明文文件可能并非权威数据。"
          }
        }
      }
    },
    "Account, encrypted, or separate ordering bookmark storage detected; plaintext may not be authoritative.": {
      "comment": "Storage capability diagnostic. Plaintext may be stale; writes remain blocked. Keep the historical account/encrypted diagnostic for persisted restrictions. Non-English text needs in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This working copy contains only plaintext Bookmarks. Other store contents are excluded; direct apply is unavailable. Current Chrome contents have not been compared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この作業コピーには平文Bookmarksのブックマークのみ含まれます。他のストアの内容は除外され、原本への直接反映は未対応です。Chromeの現在の内容とは比較していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업본에는 평문 Bookmarks의 북마크만 담겨 있습니다. 다른 저장소의 내용은 제외했고 원본 직접 반영은 지원하지 않습니다. Chrome의 현재 내용과 비교하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作副本仅包含明文Bookmarks中的书签。其他存储的内容已排除，不支持直接写回原始文件。尚未与Chrome当前内容进行比较。"
          }
        }
      }
    },
    "Addition or deletion": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Addition or deletion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "追加または削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "추가 또는 삭제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添加或删除"
          }
        }
      }
    },
    "Bookmark copies disagree; their authoritative source is unverified.": {
      "comment": "Encrypted-store compatibility diagnostic; keep credentials and cryptographic key bytes out of UI. Translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark copies disagree; their authoritative source is unverified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブックマークのコピーが一致せず、どのコピーを使うべきか確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "북마크 사본이 서로 달라 어느 사본을 사용해야 할지 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "书签副本不一致，无法确定应使用哪个副本。"
          }
        }
      }
    },
    "Bookmark encryption key is unavailable.": {
      "comment": "Encrypted-store compatibility diagnostic; keep credentials and cryptographic key bytes out of UI. Translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark encryption key is unavailable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブックマークの暗号化キーを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "북마크 암호화 키를 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法使用书签加密密钥。"
          }
        }
      }
    },
    "Bookmark storage detected without a plaintext Bookmarks file; this profile is unsupported.": {
      "comment": "Storage capability diagnostic. Plaintext may be stale; writes remain blocked. Keep the historical account/encrypted diagnostic for persisted restrictions. Non-English text needs in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark storage detected without a plaintext Bookmarks file; this profile is unsupported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "平文の Bookmarks ファイルがないブックマーク保存領域を検出しました。このプロファイルには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일반 텍스트 Bookmarks 파일이 없는 북마크 저장소가 발견되었습니다. 이 프로필은 지원되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检测到书签存储，但没有明文 Bookmarks 文件；不支持此配置文件。"
          }
        }
      }
    },
    "Chrome identity was regenerated; reconnect before applying": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome identity was regenerated; reconnect before applying"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromeの識別情報が再生成されました。反映する前に再接続してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome 식별자가 다시 생성되었습니다. 반영하기 전에 다시 연결하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome标识已重新生成；请在应用前重新连接"
          }
        }
      }
    },
    "Chrome is using this data folder. Finish your browser work and quit before applying.": {
      "comment": "A conservative lifecycle guard can also mean the affected data root could not be confirmed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome may be using this data folder. Finish your browser work and quit before applying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromeがこのデータフォルダを使用している可能性があります。作業を終えて終了してから反映してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome이 이 데이터 폴더를 사용 중일 수 있습니다. 브라우저 작업을 마친 뒤 종료하고 반영하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome 可能正在使用此数据文件夹。请完成浏览器工作并退出后再应用更改。"
          }
        }
      }
    },
    "Combined folder moves": {
      "comment": "App-authored error or review copy; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combined folder moves"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "複数のフォルダ移動による競合"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서로 영향을 주는 폴더 이동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "组合文件夹移动"
          }
        }
      }
    },
    "Direct writes are currently limited to Galmuri's local test data. Connected profiles remain read-only.": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct writes are currently limited to Galmuri's local test data. Connected profiles remain read-only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "直接書き込みは現在Galmuriのローカルテストデータに限られます。接続済みプロファイルは読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "직접 쓰기는 현재 Galmuri의 로컬 테스트 데이터에서만 가능합니다. 연결된 프로필은 읽기 전용입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前仅允许直接写入Galmuri本地测试数据。已连接的配置文件仍为只读。"
          }
        }
      }
    },
    "Ego Lite connection is experimental and read-only. Browser freshness and format compatibility are not verified.": {
      "comment": "Browser connection UI; preserve browser/folder names. Non-English text needs in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ego Lite connection is experimental and read-only. Browser freshness and format compatibility are not verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ego Liteは試験的な読み取り専用接続です。ブラウザの最新状態と形式の互換性は未検証です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ego Lite는 읽기 전용 시험 연결입니다. 브라우저의 최신 상태와 형식 호환성은 검증하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ego Lite 连接为实验性只读功能。尚未验证浏览器数据时效性和格式兼容性。"
          }
        }
      }
    },
    "Encrypted bookmark data could not be verified.": {
      "comment": "Encrypted-store compatibility diagnostic; keep credentials and cryptographic key bytes out of UI. Translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted bookmark data could not be verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暗号化されたブックマークデータを検証できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호화된 북마크 데이터를 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法验证加密书签数据。"
          }
        }
      }
    },
    "File information could not be read.": {
      "comment": "Profile source-file inventory and plaintext-only read scope. Filename/metadata observations do not prove Chrome authority.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File information could not be read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "파일 정보를 읽지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイル情報を読み取れませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法读取文件信息。"
          }
        }
      }
    },
