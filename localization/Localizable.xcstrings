    "profile.egoPreview": {
      "comment": "Browser connection UI; preserve browser/folder names. Non-English text needs in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ego Lite · Experimental, read-only connection. Only recognized plaintext bookmarks can be opened. Browser freshness and compatibility are not yet verified."
          }
