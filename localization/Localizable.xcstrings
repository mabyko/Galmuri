          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要访问 %@ 书签"
          }
        }
      }
    },
    "post-write verification failed; original backup is available": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "post-write verification failed; original backup is available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "書き込み後の検証に失敗しました。原本のバックアップは利用できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "쓰기 후 검증에 실패했습니다. 원본 백업을 사용할 수 있습니다"
          }
        },
        "zh-Hans": {
