    "profile.connectedReadOnly": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected profile · read-only. Edit and export your working copy; direct apply is unavailable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "接続済みプロファイル・読み取り専用。作業コピーの編集と書き出しは可能ですが、直接反映はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "연결된 프로필 · 읽기 전용. 작업본 편집과 내보내기는 가능하며 직접 반영은 지원하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
