    "editor.discardDetail": {
      "comment": "Discard current-profile working changes to persisted Base, never browser originals; explicit full-scope review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the source state saved in Galmuri. Added items will be removed, deleted items restored, and edits, moves and ordering reverted. Other profiles stay unchanged. This does not reread or change Chrome."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuri에 보관된 원본 상태로 돌아갑니다. 추가한 항목은 없어지고, 삭제한 항목은 복구되며, 수정·이동·순서 변경도 취소됩니다. 다른 프로필은 바뀌지 않습니다. Chrome의 현재 내용을 다시 읽거나 변경하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuriに保存された元の状態に戻します。追加した項目は削除され、削除した項目は復元され、編集・移動・並び順の変更も取り消されます。他のプロファイルは変更しません。Chromeの現在の内容を再読み込みしたり変更したりしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复到 Galmuri 中保存的原始状态。新增项目将被移除，已删除项目将恢复，编辑、移动和排序更改也会撤销。其他配置文件保持不变。不会重新读取或修改 Chrome 的当前内容。"
          }
        }
      }
    },
    "editor.discardScope": {
      "comment": "Discard current-profile working changes to persisted Base, never browser originals; explicit full-scope review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This affects all pending changes in the current profile, including hidden items."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 프로필의 숨겨진 항목을 포함한 모든 변경이 대상입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在のプロファイルの非表示項目を含む、すべての未反映の変更が対象です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此操作影响当前配置文件的所有待处理更改，包括隐藏项目。"
          }
        }
      }
    },
    "editor.discardTitle": {
      "comment": "Discard current-profile working changes to persisted Base, never browser originals; explicit full-scope review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard all changes in this profile?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 프로필의 모든 변경을 취소할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このプロファイルのすべての変更を破棄しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "放弃此配置文件中的所有更改？"
          }
        }
      }
    },
    "editor.discardUndoHelp": {
      "comment": "Discard current-profile working changes to persisted Base, never browser originals; explicit full-scope review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can undo this discard until you quit Galmuri. Undo history is not kept after relaunch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuri를 종료하기 전까지는 이 변경 취소도 되돌릴 수 있습니다. 실행 취소 기록은 앱을 다시 열면 남지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuriを終了するまでは、この破棄操作も取り消せます。再起動後に操作履歴は残りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "退出 Galmuri 前可以撤销此次放弃操作。重新启动后不会保留撤销历史。"
          }
        }
      }
    },
    "editor.discardedChanges": {
