    "extension.noProfiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No profiles are registered in Galmuri. Connect a profile in the main window first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuri에 등록된 프로필이 없습니다. 메인 화면에서 프로필을 먼저 연결해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuriに登録されたプロファイルがありません。メイン画面で先にプロファイルを接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuri 中没有已登记的配置文件。请先在主窗口连接配置文件。"
          }
        }
      }
    },
    "extension.batchHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning API editing on checks the profiles registered in Galmuri once. Use Recheck all profiles for later checks. Profiles are not rediscovered, and selecting a different profile does not rescan. After restarting the app, recheck manually."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "API 편집을 켜면 Galmuri에 등록된 프로필을 한 번 검사합니다. 이후에는 모든 프로필 다시 검사로 갱신하세요. 새 프로필을 찾아 추가하거나 선택 변경에 따라 자동 재검사하지 않습니다. 앱 재실행 후에도 수동으로 검사해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "API編集をオンにするとGalmuriに登録済みのプロファイルを一度確認します。その後は全プロファイルを再確認してください。未登録のプロファイルは検索せず、選択変更でも自動再検査しません。アプリ再起動後も手動で確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "启用 API 编辑后，会检查一次 Galmuri 中已登记的配置文件。以后请使用“重新检查所有配置文件”。不会发现新配置文件，也不会因切换选择而自动重查。重启应用后请手动检查。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
