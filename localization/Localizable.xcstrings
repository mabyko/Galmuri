    "permission.chromeSwitchDetail": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the arrow to the left of %@, then turn on Google Chrome underneath it, if listed. This is in System Settings, not Chrome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@の左の矢印をクリックし、その下にGoogle Chromeがあればスイッチをオンにしてください。Chrome内ではなく、システム設定で操作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 왼쪽의 화살표(▶)를 누른 뒤, 아래에 Google Chrome 항목이 있으면 스위치를 켜 주세요. Chrome 앱 안이 아니라 시스템 설정에서 진행합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "点击%@左侧的箭头，如果下方列出了Google Chrome，请开启其开关。请在系统设置中操作，而不是Chrome内。"
          }
        }
      }
    },
