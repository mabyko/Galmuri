    "permission.reason": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked Galmuri from reading the %@ folder. Allow folder access to choose which profiles to connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOSがGalmuriによる%@フォルダの読み取りをブロックしました。フォルダへのアクセスを許可すると、接続するプロファイルを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS가 Galmuri의 %@ 폴더 읽기를 막았습니다. 폴더 접근을 허용하면 연결할 프로필을 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS 阻止了 Galmuri 读取 %@ 文件夹。允许访问文件夹后，即可选择要连接的配置文件。"
          }
        }
      }
    },
    "permission.recheck": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
