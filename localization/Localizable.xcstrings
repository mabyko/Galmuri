    "permission.fileDetail": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a file-permission error. Check the folder’s read permissions and try again, or choose another location. An app-access switch in System Settings does not fix ordinary file permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイルのアクセス権限に関するエラーです。フォルダの読み取り権限を確認して再試行するか、別の場所を選択してください。システム設定のアプリアクセススイッチでは、通常のファイル権限は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일반 파일 권한 오류입니다. 폴더의 읽기 권한을 확인한 뒤 다시 시도하거나 다른 위치를 선택해 주세요. 시스템 설정의 앱 접근 스위치만으로는 일반 파일 권한이 바뀌지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这是文件权限错误。请检查文件夹的读取权限后重试，或选择其他位置。系统设置中的应用访问开关不会更改普通文件权限。"
          }
        }
      }
    },
    "permission.fileTitle": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
