    "profile.accessDenied.help": {
      "comment": "Do not imply that all macOS access restrictions can be bypassed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder again or check macOS access permissions. Your working copy is preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダを選び直すか、macOSのアクセス権限を確認してください。作業コピーは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더를 다시 선택하거나 macOS 접근 권한을 확인하세요. 기존 작업본은 보관합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请重新选择文件夹，或检查 macOS 访问权限。工作副本会保留。"
          }
        }
      }
    },
    "profile.accessDenied.title": {
      "comment": "Bookmark editor UI. Draft translations require native-context and language review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder cannot be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフォルダを読み取れません"
          }
