    "profile.chromeFolderHelp": {
      "comment": "Guided Chrome connection; no bookmark writes or Keychain access. Non-English copy needs native review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to your Chrome folder to find profiles. The standard location is already open; choose a different folder if you use a custom location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プロファイルを検索するため、Chromeフォルダへのアクセスを許可してください。標準の場所を開いています。別の場所を使用している場合は、そのフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로필을 찾을 수 있도록 Chrome 폴더 접근을 허용해 주세요. 기본 위치를 열어 두었습니다. 별도 위치를 사용한다면 해당 폴더를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请允许访问 Chrome 文件夹以查找配置文件。已打开默认位置；如果使用自定义位置，请选择相应文件夹。"
          }
        }
      }
    },
