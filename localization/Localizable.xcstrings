    "refresh.reviewHelp": {
      "comment": "Pre-use profile management, local source refresh and reviewed selective revert.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Galmuri will change. Previous work is archived as workspace JSON. Session undo history resets because the saved source snapshot changes. This is a disk-file snapshot, not proof of the live browser’s latest or complete contents."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuri만 바뀝니다. 이전 작업은 작업 공간 JSON으로 보관합니다. 기준 원본이 바뀌므로 실행 취소 기록은 초기화됩니다. 디스크 파일을 읽은 결과이며 실행 중인 브라우저의 최신·전체 내용이 확인된 것은 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "変更するのはGalmuriのみです。以前の作業はJSONに保存します。基準の元データが変わるため操作の取り消し履歴はリセットします。ディスク上のファイルの状態であり、実行中のブラウザの最新・全内容の確認ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅更改 Galmuri。之前的工作保存为工作区 JSON。由于基准快照更新，撤销历史会清空。这是磁盘文件快照，不能证明正在运行的浏览器中的最新或完整内容。"
          }
        }
      }
    },
    "refresh.stale": {
      "comment": "Pre-use profile management, local source refresh and reviewed selective revert.",
      "localizations": {
        "en": {
          "stringUnit": {
