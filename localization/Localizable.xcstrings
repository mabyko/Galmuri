    "bridge.failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request is unavailable, expired or changed. Refresh requests and reconnect from the extension."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요청이 만료되었거나 변경되어 확인할 수 없습니다. 요청을 새로고침하고 확장 프로그램에서 다시 연결하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要求が利用できないか、期限切れまたは変更されています。要求を更新し、拡張機能から再接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求不可用、已过期或已更改。请刷新请求并从扩展程序重新连接。"
          }
        }
      }
    },
    "bridge.limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads require explicit approval. Browser writes remain limited to marked dedicated test profiles. Sessions expire after five minutes; keep the extension tab open."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "읽기에는 명시적 승인이 필요합니다. 브라우저 반영은 전용 테스트 프로필로 제한합니다. 세션은 5분 후 만료되며 확장 탭을 열어 두어야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読み取りには明示的な承認が必要です。ブラウザへの反映は専用テストプロフィールに限定されます。セッションは5分後に期限切れとなり、拡張機能のタブを開いておく必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "读取需要明确批准。浏览器写入仍限于专用测试个人资料。会话将在5分钟后过期，请保持扩展标签页打开。"
          }
        }
      }
    },
