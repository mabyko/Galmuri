          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开文件与文件夹"
          }
        }
      }
    },
    "permission.settingsTitle": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still blocked? Check System Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "引き続きブロックされる場合はシステム設定を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계속 막히면 시스템 설정에서 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍被阻止？检查系统设置"
          }
        }
      }
    },
    "permission.settingsUnavailable": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be opened. From the Apple menu, open System Settings → Privacy & Security → Files & Folders."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定を開けませんでした。Appleメニューからシステム設定 → プライバシーとセキュリティ → ファイルとフォルダに進んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정을 열지 못했습니다. Apple 메뉴에서 시스템 설정 → 개인정보 보호 및 보안 → 파일 및 폴더로 이동하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法打开设置。请从 Apple 菜单前往系统设置 → 隐私与安全性 → 文件与文件夹。"
          }
        }
      }
    },
    "permission.title": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to %@ bookmarks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@のブックマークへのアクセスが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
