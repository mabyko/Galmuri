    "permission.returnDetail": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After enabling Google Chrome in Settings, return to Galmuri and choose Check Again below. A successful read opens the profile chooser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定でGoogle ChromeをオンにしたらGalmuriに戻り、下の「もう一度確認」を押してください。読み取りに成功するとプロファイル選択画面が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정에서 Google Chrome을 켠 뒤 Galmuri로 돌아와 아래의 다시 확인을 누르세요. 폴더를 읽을 수 있으면 프로필 선택 화면이 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在设置中开启Google Chrome后，返回Galmuri并点击下方的“重新检查”。读取成功后将打开配置文件选择界面。"
          }
        }
      }
    },
    "permission.returnStep": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
