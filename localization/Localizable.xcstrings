    "backup.restoreWarning": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring replaces the current source with this backup. Later additions may be removed. Review every change below and quit Chrome before restoring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "復元すると現在の原本をこのバックアップに置き換えます。後から追加した項目は削除される場合があります。以下の変更をすべて確認し、Chromeを終了してから復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복원하면 현재 원본을 이 백업으로 교체합니다. 백업 이후 추가한 항목이 삭제될 수 있습니다. 아래의 모든 변경사항을 검토하고 Chrome을 종료한 뒤 복원하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "恢复会将当前原始数据替换为此备份。之后添加的项目可能被删除。请检查下方所有更改，并在恢复前退出Chrome。"
          }
        }
      }
    },
