    "editor.workingCopyHelp": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to your local Galmuri working copy. Browser originals stay unchanged until a supported review and apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuriのローカル作業コピーに保存します。対応する確認・反映を行うまでブラウザの原本は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Galmuri의 로컬 작업본에 저장합니다. 지원되는 검토·반영을 진행하기 전까지 브라우저 원본은 바뀌지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存到本地 Galmuri 工作副本。在执行受支持的检查和应用之前，浏览器原始数据保持不变。"
          }
        }
      }
