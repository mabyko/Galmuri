    "permission.folderStepDetail": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button below opens the “%@” folder for you. Keep this location and choose Allow Access to This Folder in the dialog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "下のボタンで「%@」フォルダを開きます。場所を変更せず、ダイアログで「このフォルダへのアクセスを許可」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아래 버튼을 누르면 “%@” 폴더가 미리 열립니다. 위치를 바꾸지 말고 다음 창에서 이 폴더 접근 허용을 누르세요."
          }
        },
        "zh-Hans": {
