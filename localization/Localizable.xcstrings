    "refresh.help": {
      "comment": "Pre-use profile management, local source refresh and reviewed selective revert.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the current plaintext file and merge it with your working edits. Review before updating Galmuri; browser originals stay unchanged."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 평문 파일을 읽어 작업본 편집과 병합합니다. 검토 후 Galmuri만 갱신하며 브라우저 원본은 바뀌지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在の平文ファイルを読み、作業中の編集と統合します。確認後にGalmuriのみを更新し、ブラウザの元データは変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "读取当前明文文件并与工作编辑合并。检查后仅更新 Galmuri，浏览器原始文件不变。"
          }
        }
      }
    },
    "refresh.retry": {
      "comment": "Pre-use profile management, local source refresh and reviewed selective revert.",
      "localizations": {
