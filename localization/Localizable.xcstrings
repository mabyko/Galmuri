    },
    "permission.settingsDetail": {
      "comment": "Dedicated denied-access guide. Permission is granted by macOS, never by this view. Preserve browser and folder names; translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, open Privacy & Security → Files & Folders. If Galmuri is listed, review its access settings. If it is not listed, use Allow Folder Access above. Return here and choose Check Again after making a change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "システム設定 → プライバシーとセキュリティ → ファイルとフォルダを開きます。Galmuriが一覧にある場合はアクセス設定を確認してください。一覧にない場合は上のフォルダアクセス許可を使用します。設定を変更したらこの画面に戻り、「もう一度確認」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 파일 및 폴더로 이동하세요. Galmuri가 목록에 있으면 접근 권한을 확인하세요. 목록에 없다면 위의 폴더 접근 허용을 사용하세요. 설정을 바꾼 뒤 이 화면으로 돌아와 다시 확인을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在系统设置中打开“隐私与安全性”→“文件与文件夹”。如果列表中有 Galmuri，请检查其访问设置；如果没有，请使用上方的“允许访问文件夹”。更改设置后，返回此界面并点击“重新检查”。"
          }
        }
      }
    },
    "permission.settingsNavigationHelp": {
      "comment": "Browser access guide; navigation does not grant permission.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This button opens Settings. If another page opens, follow the path above. Then complete the next step yourself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 버튼은 설정 화면을 엽니다. 다른 화면이 열리면 위 경로로 이동한 뒤, 다음 단계를 직접 진행해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このボタンで設定画面を開きます。別の画面が開いた場合は上記の経路で移動し、次の手順を手動で進めてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此按钮仅打开设置。如果打开了其他页面，请按上方路径前往，然后手动完成下一步。"
          }
        }
      }
    },
    "permission.settingsReason": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS still denied access after you confirmed the browser folder. You can check Chrome access in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザフォルダを確認した後もmacOSがアクセスを拒否しました。システム設定でChromeへのアクセス権を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 폴더를 확인한 뒤에도 macOS가 접근을 거부했습니다. 시스템 설정에서 Chrome 접근 권한을 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "确认浏览器文件夹后，macOS仍拒绝访问。您可以在系统设置中检查Chrome的访问权限。"
          }
        }
      }
    },
    "permission.settingsStep": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
