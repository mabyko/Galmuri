    "bridge.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the Chrome connection tab open. Approve only its matching code; after checking approval there, open Chrome API Workspace."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome 연결 탭을 열어 두고 같은 코드만 승인하세요. 확장 탭에서 승인을 확인한 뒤 Chrome API 작업본을 여세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chrome 接続タブを開いたまま、一致するコードのみ承認してください。拡張機能で承認を確認してから Chrome API ワークスペースを開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请保持 Chrome 连接标签页打开，仅批准相同的连接码。在扩展中检查批准状态后打开 Chrome API 工作区。"
          }
        }
      }
    },
