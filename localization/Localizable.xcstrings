    "refresh.completeHelp": {
      "comment": "Pre-use profile management, local source refresh and reviewed selective revert.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Galmuri now uses the reviewed merge and the newly read source snapshot. Browser files were not written. Your previous workspace is saved as JSON below; import it to recover."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검토한 병합 결과와 새로 읽은 원본을 Galmuri에 보관했습니다. 브라우저 파일은 쓰지 않았습니다. 이전 작업 공간은 아래 JSON에 보관했으며 불러오기로 복구할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "確認した統合結果と新しく読み込んだ元データをGalmuriに保存しました。ブラウザのファイルには書き込んでいません。以前のワークスペースは以下のJSONから読み込んで復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已在 Galmuri 中保存检查过的合并结果和新读取的源快照，未写入浏览器文件。之前的工作区保存在下方 JSON 中，可导入恢复。"
          }
        }
      }
    },
    "refresh.conflictHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the saved source, your working copy and the newly read plaintext file. Choose each conflict explicitly. Other source files and the live browser model are not included."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보관된 원본·작업본·새로 읽은 평문 파일을 비교하고 충돌마다 선택하세요. 다른 저장 파일과 실행 중인 브라우저의 메모리 상태는 포함하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存済みの元データ、作業コピー、新しく読み込んだ平文ファイルを比較し、各競合を選択してください。他の保存ファイルや実行中のブラウザのメモリ状態は含みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "比较保存的源数据、工作副本和新读取的明文文件，并逐一选择冲突。不包含其他存储文件或正在运行的浏览器内存状态。"
          }
        }
      }
    },
    "refresh.finalTitle": {
      "localizations": {
