    "editor.excludeHelp": {
      "comment": "Native bookmark editing UX; working-copy changes only. Non-English copy needs language review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items are deleted from Galmuri’s working copy, including everything inside selected folders. You can undo this change. Browser originals change only after review and apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択したフォルダ内の項目も含め、Galmuriの作業コピーから削除します。取り消しで元に戻せます。ブラウザの原本は確認して反映した場合のみ変更されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 폴더 안의 항목까지 Galmuri 작업본에서 삭제합니다. 되돌리기로 복구할 수 있습니다. 브라우저 원본은 검토 후 반영할 때만 변경됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从 Galmuri 工作副本中删除项目，包括所选文件夹中的所有内容。此更改可撤销。浏览器原始数据仅在检查并应用后更改。"
          }
        }
      }
    },
