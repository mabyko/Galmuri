    "profile.folderAccessPrompt": {
      "comment": "Permission routing UI. Settings entries are conditional; only the user changes OS authorization. Preserve app/folder names; translations need native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “%@” data folder is already open. Keep this location and choose Allow Access to This Folder. Galmuri will then read the available profiles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」データフォルダを開いています。場所を変更せず「このフォルダへのアクセスを許可」を押してください。確認後、プロファイルを自動で読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” 데이터 폴더를 미리 열어 두었습니다. 위치를 바꾸지 말고 이 폴더 접근 허용을 누르세요. 확인 후 프로필을 자동으로 읽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已预先打开“%@”数据文件夹。请保留此位置并点击“允许访问此文件夹”。确认后将自动读取配置文件。"
          }
        }
      }
    },
