    "profile.removeHelp": {
      "comment": "Pre-use profile management, local source refresh and reviewed selective revert.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private workspace JSON backup is saved first, including pending edits. Then this entry is removed from Galmuri. Browser files and original-backup history are untouched. Import the saved JSON to recover the previous workspace."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 미반영 편집을 포함한 작업 공간을 비공개 로컬 JSON으로 보관한 뒤, 이 프로필을 목록에서 제거합니다. 브라우저 파일과 원본 백업 기록은 바뀌지 않습니다. 보관된 JSON을 불러오면 이전 작업 공간을 복구할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未反映の編集を含むワークスペースを非公開のローカルJSONに保存してから、一覧から削除します。ブラウザのファイルと元データのバックアップ履歴は変更しません。保存したJSONを読み込むと以前のワークスペースを復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先将包含待处理编辑的工作区保存为私有本地 JSON，再从列表中移除此配置文件。浏览器文件和原始备份历史不会更改。导入保存的 JSON 可恢复之前的工作区。"
          }
        }
      }
    },
    "profile.removeNamed": {
