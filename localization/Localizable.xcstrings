    "settings.overviewHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit saved working copies in the main window. Choose Labs in the sidebar for optional browser-apply experiments."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메인 화면에서 저장된 작업본을 편집할 수 있습니다. 선택형 브라우저 반영 기능은 왼쪽 실험실 메뉴에서 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存済みの作業コピーはメイン画面で編集できます。任意のブラウザ反映機能は左の実験室メニューで確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在主窗口中编辑已保存的工作副本。可选浏览器写入实验请从左侧实验室菜单查看。"
          }
        }
      }
    },
