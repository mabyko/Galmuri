          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法编码PNG图像"
          }
        }
      }
    },
    "Profile identity changed; the working copy is preserved.": {
      "comment": "Profile folder reauthorization; does not reset or rebase working edits.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile identity changed; the working copy is preserved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プロファイルの識別情報が変わりました。作業コピーは保持しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로필 식별 정보가 달라졌습니다. 작업본은 보존했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "配置文件标识已更改；工作副本已保留。"
          }
        }
      }
    },
    "Resolve every conflict before applying changes.": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve every conflict before applying changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての競合を解決してから変更を反映してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 충돌을 해결한 뒤 변경사항을 반영하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先解决所有冲突，再应用更改。"
          }
        }
      }
    },
    "Select the original profile folder. A different or moved source is not automatically remapped.": {
      "comment": "Profile folder reauthorization; does not reset or rebase working edits.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the original profile folder. A different or moved source is not automatically remapped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元のプロファイルフォルダを選択してください。別の場所や移動した原本には自動で関連付けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "원래 프로필 폴더를 선택하세요. 다른 위치나 이동한 원본으로 자동 연결하지 않습니다."
          }
        },
        "zh-Hans": {
