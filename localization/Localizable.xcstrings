    "No plaintext Bookmarks files were found in the selected folder.": {
      "comment": "App-authored UI copy. Preserve user content; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plaintext Bookmarks files were found in the selected folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択したフォルダに平文のBookmarksファイルが見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 폴더에서 일반 텍스트 Bookmarks 파일을 찾을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在所选文件夹中未找到明文Bookmarks文件。"
          }
        }
      }
    },
    "Nonempty merged bookmark ordering is unsupported.": {
      "comment": "Encrypted-store compatibility diagnostic; keep credentials and cryptographic key bytes out of UI. Translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonempty merged bookmark ordering is unsupported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "複数の保存先を統合したカスタム順序には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여러 저장소의 사용자 지정 북마크 순서는 아직 지원하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚不支持合并书签存储中的自定义排序。"
          }
        }
      }
    },
    "PNG encoding": {
      "comment": "App-authored error or review copy; non-English translations need in-context review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG encoding"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PNG画像をエンコードできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
